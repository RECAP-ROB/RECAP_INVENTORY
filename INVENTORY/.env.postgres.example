# PostgreSQL Configuration for Local Development
# Copy to .env and adjust as needed

# Option 1: Use individual environment variables (easier for local dev)
POSTGRES_DB=recap
POSTGRES_USER=recap
POSTGRES_PASSWORD=recap_pass
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
CONN_MAX_AGE=600

# Option 2: Use DATABASE_URL format (easier for managed DB / Heroku-style)
# DATABASE_URL=postgres://recap:recap_pass@127.0.0.1:5432/recap

# Redis (for Celery and Channels)
REDIS_URL=redis://127.0.0.1:6379/0

# MQTT settings
MQTT_BROKER_HOST=10.15.173.106
MQTT_BROKER_PORT=1883
MQTT_TOPIC=shelf/status
MQTT_CLIENT_ID=inventory-mqtt-client
MQTT_KEEPALIVE=60
